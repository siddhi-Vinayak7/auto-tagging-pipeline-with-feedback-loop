# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# Supabase Postgres — Session Pooler connection string
# Format: postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME

# Groq API key — obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY
